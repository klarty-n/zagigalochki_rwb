{
  "name": "capibara-analytics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "node --test server/*.test.mjs",
    "benchmark:categories": "node server/benchmark-category.mjs"
  },
  "dependencies": {
    "@fontsource/geologica": "^5.2.0",
    "csv-parse": "^7.0.3",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  }
}
